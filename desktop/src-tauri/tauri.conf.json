{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GabbaProc Companion",
  "version": "0.1.2",
  "identifier": "info.kellerkind.gabbaproc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GabbaProc Companion",
        "width": 920,
        "height": 780,
        "minWidth": 650,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyOUU5MTZDQkE2NEE5QzUKUldURnFXUzZiSkdlb3FzWXNoZ0x6WmhiaEwzRWJMbjZFQzBlRjYzeUxmMmNkbDQxb3dwUkc2cVgK",
      "endpoints": [
        "https://github.com/Gabbajoe/GabbaProcPlatform/releases/latest/download/latest.json"
      ]
    }
  }
}
